        // Update stats
        function updateStats() {
            document.getElementById('totalAmbassadors').textContent = ambassadors.length;
            const totalScans = ambassadors.reduce((sum, a) => sum + a.scans, 0);
            document.getElementById('totalScans').textContent = totalScans.toLocaleString();
            document.getElementById('activeUsers').textContent = Math.floor(totalScans * 0.65).toLocaleString();
        }

        // Render ambassadors
        function renderAmbassadors() {
            const grid = document.getElementById('ambassadorGrid');
            grid.innerHTML = '';

            ambassadors.forEach(ambassador => {
                const card = document.createElement('div');
                card.className = 'ambassador-card';
                card.style.background = `linear-gradient(135deg, ${ambassador.branding.primaryColor} 0%, ${ambassador.branding.secondaryColor} 100%)`;
                card.onclick = () => editAmbassador(ambassador);

                card.innerHTML = `
                    <span class="ambassador-avatar">${ambassador.avatar.value}</span>
                    <div class="ambassador-name">${ambassador.displayName}</div>
                    <div class="ambassador-description">${ambassador.description}</div>
                    <div class="ambassador-tags">
                        ${ambassador.tags.map(tag => `<span class="tag">${tag}</span>`).join('')}
                    </div>
                `;

                grid.appendChild(card);
            });
        }

        // Render top ambassadors table
        function renderTopAmbassadors() {
            const tbody = document.getElementById('topAmbassadors');
            tbody.innerHTML = '';

            const sorted = [...ambassadors].sort((a, b) => b.scans - a.scans);

            sorted.forEach(ambassador => {
                const row = document.createElement('tr');
                row.innerHTML = `
                    <td>
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <span style="font-size: 24px;">${ambassador.avatar.value}</span>
                            <strong>${ambassador.displayName}</strong>
                        </div>
                    </td>
                    <td>${ambassador.scans.toLocaleString()}</td>
                    <td>${ambassador.interactions.toLocaleString()}</td>
                    <td>${ambassador.satisfaction}/5.0</td>
                    <td><span class="badge badge-success">${ambassador.status}</span></td>
                `;
                tbody.appendChild(row);
            });
        }

        // Show create ambassador modal
        function showCreateAmbassador() {
            currentAmbassador = null;
            document.getElementById('modalTitle').textContent = 'Create New Ambassador';
            resetAmbassadorForm();
            openModal('ambassadorModal');
        }

        // Edit ambassador
        function editAmbassador(ambassador) {
            currentAmbassador = ambassador;
            document.getElementById('modalTitle').textContent = 'Edit Ambassador';
            populateAmbassadorForm(ambassador);
            openModal('ambassadorModal');
        }

        // Reset ambassador form
        function resetAmbassadorForm() {
            document.getElementById('ambassadorId').value = '';
            document.getElementById('ambassadorName').value = '';
            document.getElementById('ambassadorDisplayName').value = '';
            document.getElementById('ambassadorDescription').value = '';
            document.getElementById('ambassadorTagline').value = '';
            document.getElementById('ambassadorRole').value = '';
            document.getElementById('ambassadorTags').value = '';
            document.getElementById('avatarValue').value = '🤖';
            document.getElementById('avatarAlternatives').value = '';
            document.getElementById('primaryColor').value = '#6366f1';
            document.getElementById('primaryColorHex').value = '#6366f1';
            document.getElementById('secondaryColor').value = '#8b5cf6';
            document.getElementById('secondaryColorHex').value = '#8b5cf6';
            document.getElementById('worldName').value = '';
            document.getElementById('worldDescription').value = '';
        }

        // Populate ambassador form
        function populateAmbassadorForm(ambassador) {
            document.getElementById('ambassadorId').value = ambassador.id;
            document.getElementById('ambassadorName').value = ambassador.name;
            document.getElementById('ambassadorDisplayName').value = ambassador.displayName;
            document.getElementById('ambassadorDescription').value = ambassador.description;
            document.getElementById('ambassadorTags').value = ambassador.tags.join(', ');
            document.getElementById('avatarValue').value = ambassador.avatar.value;
            document.getElementById('avatarAlternatives').value = ambassador.avatar.alternatives.join(', ');
            document.getElementById('primaryColor').value = ambassador.branding.primaryColor;
            document.getElementById('primaryColorHex').value = ambassador.branding.primaryColor;
            document.getElementById('secondaryColor').value = ambassador.branding.secondaryColor;
            document.getElementById('secondaryColorHex').value = ambassador.branding.secondaryColor;
        }

        // Save ambassador
        function saveAmbassador() {
            const ambassador = {
                id: document.getElementById('ambassadorId').value,
                name: document.getElementById('ambassadorName').value,
                displayName: document.getElementById('ambassadorDisplayName').value,
                description: document.getElementById('ambassadorDescription').value,
                tagline: document.getElementById('ambassadorTagline').value,
                role: document.getElementById('ambassadorRole').value,
                tags: document.getElementById('ambassadorTags').value.split(',').map(t => t.trim()),
                avatar: {
                    type: document.getElementById('avatarType').value,
                    value: document.getElementById('avatarValue').value,
                    alternatives: document.getElementById('avatarAlternatives').value.split(',').map(a => a.trim())
                },
                branding: {
                    primaryColor: document.getElementById('primaryColor').value,
                    secondaryColor: document.getElementById('secondaryColor').value,
                    theme: document.getElementById('brandingTheme').value
                },
                world: {
                    type: document.getElementById('worldType').value,
                    name: document.getElementById('worldName').value,
                    description: document.getElementById('worldDescription').value,
                    environment: {
                        background: document.getElementById('worldBackground').value,
                        music: document.getElementById('worldMusic').value,
                        effects: document.getElementById('worldEffects').value.split(',').map(e => e.trim())
                    }
                },
                agentMapping: {
                    baseAgent: document.getElementById('baseAgent').value,
                    customAgent: document.getElementById('customAgent').value,
                    agentFile: document.getElementById('agentFile').value,
                    functionName: document.getElementById('functionName').value
                },
                status: 'active',
                scans: currentAmbassador ? currentAmbassador.scans : 0,
                interactions: currentAmbassador ? currentAmbassador.interactions : 0,
                satisfaction: currentAmbassador ? currentAmbassador.satisfaction : 0
            };

            if (document.getElementById('enableSeededDemo').checked) {
                ambassador.demoConfiguration = {
                    seededRun: true,
                    parameters: {
                        userGuid: document.getElementById('demoUserGuid').value,
                        memorySeed: document.getElementById('memorySeedId').value,
                        model: document.getElementById('demoModel').value,
                        temperature: parseFloat(document.getElementById('demoTemperature').value),
                        maxTokens: parseInt(document.getElementById('demoMaxTokens').value)
                    }
                };
            }

            if (currentAmbassador) {
                const index = ambassadors.findIndex(a => a.id === currentAmbassador.id);
                ambassadors[index] = ambassador;
            } else {
                ambassadors.push(ambassador);
            }

            renderAmbassadors();
            updateStats();
            closeModal('ambassadorModal');

            showAlert('success', 'Ambassador saved successfully!');
        }

        // Export ambassador
        function exportAmbassador() {
            const ambassador = {
                ambassador: {
                    id: document.getElementById('ambassadorId').value,
                    name: document.getElementById('ambassadorName').value,
                    displayName: document.getElementById('ambassadorDisplayName').value,
                    description: document.getElementById('ambassadorDescription').value,
                    tagline: document.getElementById('ambassadorTagline').value,
                    role: document.getElementById('ambassadorRole').value,
                    tags: document.getElementById('ambassadorTags').value.split(',').map(t => t.trim()),
                    avatar: {
                        type: document.getElementById('avatarType').value,
                        value: document.getElementById('avatarValue').value,
                        alternatives: document.getElementById('avatarAlternatives').value.split(',').map(a => a.trim())
                    },
                    branding: {
                        primaryColor: document.getElementById('primaryColor').value,
                        secondaryColor: document.getElementById('secondaryColor').value,
                        theme: document.getElementById('brandingTheme').value
                    },
                    world: {
                        type: document.getElementById('worldType').value,
                        name: document.getElementById('worldName').value,
                        description: document.getElementById('worldDescription').value
                    }
                }
            };

            const blob = new Blob([JSON.stringify(ambassador, null, 2)], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `${ambassador.ambassador.id}.json`;
            a.click();
        }

        // Add capability
        function addCapability() {
            const list = document.getElementById('capabilitiesList');
            const item = document.createElement('div');
            item.className = 'capability-item';
            item.innerHTML = `
                <span class="capability-icon">💡</span>
                <div style="flex: 1;">
                    <input type="text" placeholder="Capability name" class="capability-name" style="margin-bottom: 8px; width: 100%; padding: 8px; border: 2px solid var(--border); border-radius: 8px;">
                    <textarea placeholder="Description" class="capability-desc" style="width: 100%; padding: 8px; border: 2px solid var(--border); border-radius: 8px;"></textarea>
                </div>
                <button class="btn btn-danger" onclick="removeCapability(this)">Remove</button>
            `;
            list.appendChild(item);
        }

        // Remove capability
        function removeCapability(btn) {
            btn.closest('.capability-item').remove();
        }

        // Show QR generator
        function showQRGenerator() {
            const select = document.getElementById('qrAmbassador');
            select.innerHTML = ambassadors.map(a =>
                `<option value="${a.id}">${a.displayName}</option>`
            ).join('');

            openModal('qrModal');
        }

        // Generate QR code
        function generateQR() {
            const ambassadorId = document.getElementById('qrAmbassador').value;
            const location = document.getElementById('qrLocation').value;
            const baseUrl = document.getElementById('qrBaseUrl')?.value || 'https://ai-ambassadors.app/enter/';

            const url = `${baseUrl}${ambassadorId}?source=${location}`;
            document.getElementById('qrUrl').textContent = url;

            const qrContainer = document.getElementById('qrCodePreview');
            qrContainer.innerHTML = '';

            QRCode.toCanvas(url, { width: 250, margin: 2 }, (error, canvas) => {
                if (error) {
                    console.error(error);
                    return;
                }
                qrContainer.appendChild(canvas);
            });

            showAlert('success', 'QR Code generated successfully!');
        }

        // Download QR as PNG
        function downloadQR() {
            const canvas = document.querySelector('#qrCodePreview canvas');
            if (canvas) {
                const url = canvas.toDataURL('image/png');
                const a = document.createElement('a');
                a.href = url;
                a.download = `qr-${document.getElementById('qrAmbassador').value}.png`;
                a.click();
            }
        }

        // Download QR as SVG
        function downloadQRSVG() {
            const ambassadorId = document.getElementById('qrAmbassador').value;
            const location = document.getElementById('qrLocation').value;
            const baseUrl = document.getElementById('qrBaseUrl')?.value || 'https://ai-ambassadors.app/enter/';
            const url = `${baseUrl}${ambassadorId}?source=${location}`;

            QRCode.toString(url, { type: 'svg' }, (error, svg) => {
                if (error) {
                    console.error(error);
                    return;
                }
                const blob = new Blob([svg], { type: 'image/svg+xml' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `qr-${ambassadorId}.svg`;
                a.click();
            });
        }

        // Show create memory seed
        function showCreateMemorySeed() {
            const select = document.getElementById('seedAmbassador');
            select.innerHTML = ambassadors.map(a =>
                `<option value="${a.id}">${a.displayName}</option>`
            ).join('');

            openModal('memorySeedModal');
        }

        // Save memory seed
        function saveMemorySeed() {
            try {
                const memoriesText = document.getElementById('memoryEditor').textContent;
                const memories = JSON.parse(memoriesText);

                const seed = {
                    id: document.getElementById('seedId').value,
                    version: document.getElementById('seedVersion').value,
                    description: document.getElementById('seedDescription').value,
                    ambassadorId: document.getElementById('seedAmbassador').value,
                    memories: memories
                };

                memorySeeds.push(seed);
                closeModal('memorySeedModal');
                showAlert('success', 'Memory seed saved successfully!');

                // Export to file
                const blob = new Blob([JSON.stringify(seed, null, 2)], { type: 'application/json' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `${seed.id}.json`;
                a.click();
            } catch (error) {
                showAlert('danger', 'Invalid JSON format! Please check your memory configuration.');
            }
        }

        // Validate JSON
        function validateJSON() {
            try {
                const text = document.getElementById('memoryEditor').textContent;
                JSON.parse(text);
                showAlert('success', 'JSON is valid!');
            } catch (error) {
                showAlert('danger', `JSON Error: ${error.message}`);
            }
        }

