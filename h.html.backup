                }
            ];

            qrCodes = [
                {
                    id: 'qr-001',
                    ambassadorId: 'creative-001',
                    location: 'store_nyc_5th',
                    url: 'https://ai-ambassadors.app/enter/creative-001?source=store_nyc_5th',
                    scans: 847,
                    created: '2025-01-15'
                },
                {
                    id: 'qr-002',
                    ambassadorId: 'creative-001',
