        function showEmojiPicker() {
            const emojis = ['😀', '😃', '😄', '😁', '🎨', '🎭', '🎪', '🎬', '🎮', '🎯', '🎲', '🎰', '🎳', '🚀', '✈️', '🚁', '🛸', '🚢', '⛵', '🏎️', '🚜', '🚲', '🛴', '🏍️', '🚨', '🚔', '🚍', '🚘', '🚖', '🚡', '🚠', '🚟', '🚃', '🚋', '🚞', '🚝', '🚄', '🚅', '🚈', '🚂', '🚆', '🚇', '🚊', '🚉', '✨', '⭐', '🌟', '💫', '🔥', '💥', '🎆', '🎇', '🌈', '☀️', '⛅', '⛈️', '🌤️', '🌥️', '🌦️', '🌧️', '⛆', '☔', '💧', '💦', '🌊', '🌴', '🌵', '🌾', '🌿', '☘️', '🍀', '🍁', '🍂', '🍃', '🌺', '🌻', '🌼', '🌷', '🌹', '🥀', '🌸', '💐', '🏵️', '🌱', '🌲', '🌳', '🌴', '🌵', '🌾', '🌿', '☘️', '🦋', '🐛', '🐝', '🐞', '🦗', '🕷️', '🦂', '🦟', '🦠', '🐚', '🦀', '🦞', '🦐', '🦑', '🐙', '🦈', '🐬', '🐳', '🐋', '🐟', '🐠', '🐡', '🦭', '🐅', '🐆', '🦓', '🦍', '🦧', '🐘', '🦛', '🦏', '🐪', '🐫', '🦒', '🦘', '🐃', '🐂', '🐄', '🐎', '🐖', '🐏', '🐑', '🦙', '🐐', '🦌', '🐕', '🐩', '🦮', '🐕‍🦺', '🐈', '🐈‍⬛', '🪶', '🐓', '🦃', '🦅', '🦆', '🦢', '🦉', '🦤', '🪶', '🦩', '🦚', '🦜', '🐦', '🐧', '🐥', '🐤', '🐣', '💻', '⌨️', '🖥️', '🖨️', '🖱️', '🖲️', '💾', '💿', '📀', '📱', '📲', '☎️', '📞', '📟', '📠', '📺', '📻', '🎙️', '🎚️', '🎛️', '🧭', '⏱️', '⏲️', '⏰', '🕰️', '⏳', '⏲️', '📡', '🔋', '🔌', '💡', '🔦', '🕯️', '🪔', '🧯', '🛢️', '💸', '💵', '💴', '💶', '💷', '💰', '💳', '⚖️', '🧰', '🔧', '🔨', '⚒️', '🛠️', '⛏️', '🔩', '⚙️', '🧱', '⛓️', '🧲', '🔫', '💣', '🧨', '🪓', '🔪', '🗡️', '⚔️', '🛡️', '🚬', '⚰️', '⚱️', '🏺', '🔮', '📿', '🧿', '💈', '⚗️', '🔭', '🔬', '🕳️', '💊', '💉', '🩹', '🩺', '🌡️', '🧬', '🦠'];

            const picker = document.getElementById('emojiPicker');
            picker.innerHTML = emojis.map(emoji =>
                `<div class="emoji-option" onclick="selectEmoji('${emoji}')">${emoji}</div>`
            ).join('');

            openModal('emojiPickerModal');
        }

        // Select emoji
        function selectEmoji(emoji) {
            document.getElementById('avatarValue').value = emoji;
            closeModal('emojiPickerModal');
        }

        // Filter ambassadors
        function filterAmbassadors(filter) {
            const grid = document.getElementById('ambassadorGrid');
            const cards = grid.querySelectorAll('.ambassador-card');

            cards.forEach((card, index) => {
                const ambassador = ambassadors[index];
                if (filter === 'all' || ambassador.status === filter) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        // Search ambassadors
        function searchAmbassadors(query) {
            const grid = document.getElementById('ambassadorGrid');
            const cards = grid.querySelectorAll('.ambassador-card');

            cards.forEach((card, index) => {
                const ambassador = ambassadors[index];
                const searchText = `${ambassador.name} ${ambassador.displayName} ${ambassador.description} ${ambassador.tags.join(' ')}`.toLowerCase();

                if (searchText.includes(query.toLowerCase())) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        // Modal functions
        function openModal(modalId) {
            document.getElementById(modalId).classList.add('active');
        }

        function closeModal(modalId) {
            document.getElementById(modalId).classList.remove('active');
        }

        // Settings functions
        function saveSettings() {
            const settings = {
                azureFunctionUrl: document.getElementById('azureFunctionUrl').value,
                functionKey: document.getElementById('functionKey').value,
                qrBaseUrl: document.getElementById('qrBaseUrl').value,
                analyticsEnabled: document.getElementById('analyticsEnabled').value === 'true'
            };

            localStorage.setItem('ambassadorSettings', JSON.stringify(settings));
            showAlert('success', 'Settings saved successfully!');
        }

        function exportData() {
            const data = {
                ambassadors: ambassadors,
                qrCodes: qrCodes,
                memorySeeds: memorySeeds,
                exportDate: new Date().toISOString()
            };

            const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `ambassador-data-${Date.now()}.json`;
            a.click();

            showAlert('success', 'Data exported successfully!');
        }

        function importData() {
            const input = document.createElement('input');
            input.type = 'file';
            input.accept = 'application/json';
            input.onchange = function(e) {
                const file = e.target.files[0];
                const reader = new FileReader();
                reader.onload = function(event) {
                    try {
                        const data = JSON.parse(event.target.result);
                        ambassadors = data.ambassadors || ambassadors;
                        qrCodes = data.qrCodes || qrCodes;
                        memorySeeds = data.memorySeeds || memorySeeds;

                        renderAmbassadors();
                        updateStats();
                        showAlert('success', 'Data imported successfully!');
                    } catch (error) {
                        showAlert('danger', 'Failed to import data. Invalid JSON format.');
                    }
                };
                reader.readAsText(file);
            };
            input.click();
        }

        // Alert function
        function showAlert(type, message) {
            const alertDiv = document.createElement('div');
            alertDiv.className = `alert alert-${type}`;
            alertDiv.textContent = message;
            alertDiv.style.position = 'fixed';
            alertDiv.style.top = '20px';
            alertDiv.style.right = '20px';
            alertDiv.style.zIndex = '10000';
            alertDiv.style.minWidth = '300px';

            document.body.appendChild(alertDiv);

            setTimeout(() => {
                alertDiv.remove();
            }, 3000);
        }

        // Load settings on startup
        function loadSettings() {
            const settings = localStorage.getItem('ambassadorSettings');
            if (settings) {
                const parsed = JSON.parse(settings);
                if (document.getElementById('azureFunctionUrl')) {
                    document.getElementById('azureFunctionUrl').value = parsed.azureFunctionUrl || '';
                    document.getElementById('functionKey').value = parsed.functionKey || '';
                    document.getElementById('qrBaseUrl').value = parsed.qrBaseUrl || 'https://ai-ambassadors.app/enter/';
                    document.getElementById('analyticsEnabled').value = parsed.analyticsEnabled ? 'true' : 'false';
                }
            }
        }

        // Initialize settings
        setTimeout(loadSettings, 100);
    </script>
</body>
</html>
